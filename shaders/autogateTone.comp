#version 310 es
#extension GL_EXT_shader_implicit_conversions : require
precision highp float;
precision highp int;
layout(local_size_x=64) in;
layout(std430,binding=0) buffer B0 { float counts[]; };
layout(std430,binding=1) buffer B1 { uint palette[]; };
layout(std430,binding=2) buffer B2 { uint pixels[]; };
layout(std430,binding=3) buffer B3 { float curve[]; };
uniform vec2 windowBounds;
uniform int useAutogate;

void main(){
uint i=gl_GlobalInvocationID.x;

    if(i>=640u*512u)return;
    float v=clamp(counts[i],0.,65535.);uint j=min(65534u,uint(v));
    float t=useAutogate!=0?mix(curve[j],curve[j+1],v-float(j)):(v-windowBounds.x)/max(1.,windowBounds.y-windowBounds.x);
    pixels[i]=palette[min(255u,uint(clamp(t,0.,1.)*255.))];

}
