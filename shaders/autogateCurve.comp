#version 310 es
#extension GL_EXT_shader_implicit_conversions : require
precision highp float;
precision highp int;
layout(local_size_x=64) in;
layout(std430,binding=0) buffer B0 { float previous[]; };
layout(std430,binding=1) buffer B1 { float next[]; };
layout(std430,binding=2) buffer B2 { float cdf[]; };
uniform vec4 b;
uniform vec4 control;
uniform vec4 migration;

void main(){
uint i=gl_GlobalInvocationID.x;

    if(i>=65536u)return;
    float x=clamp(migration.x+(float(i)-migration.z)*max(1.,migration.y-migration.x)/max(1.,migration.w-migration.z),0.,65535.);uint a=min(65534u,uint(x));
    float old=mix(previous[a],previous[a+1],x-float(a));
    if(control.z==0 && control.w==0){next[i]=old;return;}
    float v=float(i),target;
    if(v<b.y)target=.05*clamp((v-b.x)/max(b.y-b.x,1.),0.,1.);
    else if(v>b.z)target=.95+.05*clamp((v-b.z)/max(b.w-b.z,1.),0.,1.);
    else {float z=clamp((v-b.y)/max(b.z-b.y,1.)*512.,0.,512.);uint j=min(511u,uint(z));
        target=.05+.9*mix(cdf[j],cdf[j+1],z-float(j));}
    next[i]=control.w>0?target:mix(old,target,control.y);

}
