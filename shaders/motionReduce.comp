#version 310 es
#extension GL_EXT_shader_implicit_conversions : require
precision highp float;
precision highp int;
layout(local_size_x=64) in;
layout(std430,binding=0) buffer B0 { float src[]; };
layout(std430,binding=1) buffer B1 { float dst[]; };
layout(std430,binding=2) buffer B2 { uint slots[]; };
uniform uvec4 p;

vec2 motionPoint(vec2 p,vec4 m){vec2 v=p-vec2(319.5,255.5);float c=cos(m.z),s=sin(m.z);return vec2(c*v.x-s*v.y,s*v.x+c*v.y)+vec2(319.5,255.5)+m.xy;}

void main(){
uint i=gl_GlobalInvocationID.x;

 uint w=p.y/2,h=p.z/2,n=w*h;if(i>=n*p.x)return;uint slot=slots[i/n],x=i%w,y=i/w%h,at=slot*p.y*p.z+2*y*p.y+2*x;dst[slot*n+i%n]=(src[at]+src[at+1]+src[at+p.y]+src[at+p.y+1])*.25;

}
