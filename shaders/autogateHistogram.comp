#version 310 es
#extension GL_EXT_shader_implicit_conversions : require
precision highp float;
precision highp int;
layout(local_size_x=64) in;
layout(std430,binding=0) buffer B0 { float raw[]; };
layout(std430,binding=1) buffer B1 { uint hist[]; };
uniform vec4 bounds;

void main(){
uint i=gl_GlobalInvocationID.x;

    if (i >= 160u*128u) return;
    float v=raw[(i/160u)*4u*640u+(i%160u)*4u];
    if(v>=bounds.y && v<=bounds.z) {
        uint bin=min(511u,uint((v-bounds.y)/max(bounds.z-bounds.y,1.)*512.));
        atomicAdd(hist[bin],1u);
    }

}
