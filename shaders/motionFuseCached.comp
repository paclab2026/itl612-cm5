// Two exact RAW16 counts per SSBO word; no float widening or extra host copy.
uint rawAt(uint i){return (raw[i>>1u]>>((i&1u)*16u))&65535u;}
uniform uint count;uniform float sigma;
void main(){uint i=gl_GlobalInvocationID.x;if(i>=327680u)return;uint x=i%640u,y=i/640u;float sum=0.0,sw=1.0,sw2=1.0;uint used=0u;
