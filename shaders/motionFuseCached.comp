 for(int yy=-1;yy<=1;yy++)for(int xx=-1;xx<=1;xx++){vec2 d=warped[start+uint(int(i)+yy*640+xx)];valid=valid&&d.y>0.0;mse+=d.x*d.x;}
 if(!valid)continue;float robust=max(0.0,1.0-mse/(9.0*36.0*sigma*sigma)),weight=robust*robust*alignment[k].y;if(weight>0.0)used++;sum+=weight*warped[start+i].x;sw+=weight;sw2+=weight*weight;}
 float ne=sw*sw/sw2;bool gain=used>0u&&ne>baselineN[i]+.05;resultData[i]=gain?float(rawAt(slots[0]*327680u+i))+sum/sw:baseline[i];effective[i]=gain?ne:baselineN[i];
}
