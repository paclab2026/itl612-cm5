#version 310 es
#extension GL_EXT_shader_implicit_conversions : require
precision highp float;
precision highp int;
layout(local_size_x=64) in;
layout(std430,binding=0) buffer B0 { float base[]; };
layout(std430,binding=1) buffer B1 { float baseN[]; };
layout(std430,binding=2) buffer B2 { float candidate[]; };
layout(std430,binding=3) buffer B3 { float candidateN[]; };
layout(std430,binding=4) buffer B4 { float resultData[]; };
layout(std430,binding=5) buffer B5 { float effective[]; };
layout(std430,binding=6) buffer B6 { vec2 energy[]; };
uniform float sigma;

vec2 motionPoint(vec2 p,vec4 m){vec2 v=p-vec2(319.5,255.5);float c=cos(m.z),s=sin(m.z);return vec2(c*v.x-s*v.y,s*v.x+c*v.y)+vec2(319.5,255.5)+m.xy;}

void main(){
uint i=gl_GlobalInvocationID.x;

 if(i>=640*512)return;ivec2 q=ivec2(i%640,i/640);float eb=0,ed=0;for(int y=-1;y<=1;y++)for(int x=-1;x<=1;x++){ivec2 at=clamp(q+ivec2(x,y),ivec2(0),ivec2(639,511));vec2 e=energy[at.y*640+at.x];eb+=e.x;ed+=e.y;}eb/=9;ed/=9;float blend=eb>9*sigma*sigma?clamp((.98-sqrt(ed/max(eb,1e-6)))/.08,0.,1.):0;resultData[i]=mix(candidate[i],base[i],blend);
 // Shared observations: conservative frame-weight proxy, never sum two Ne values.
 effective[i]=blend==0?candidateN[i]:(blend==1?baseN[i]:min(candidateN[i],baseN[i]));

}
