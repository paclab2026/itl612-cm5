#version 310 es
#extension GL_EXT_shader_implicit_conversions : require
precision highp float;
precision highp int;
layout(local_size_x=64) in;
layout(std430,binding=0) buffer B0 { uint raw[]; };
layout(std430,binding=1) buffer B1 { uint slots[]; };
layout(std430,binding=2) buffer B2 { vec4 model[]; };
layout(std430,binding=3) buffer B3 { float deltas[]; };

// Two exact RAW16 counts per SSBO word; no float widening or extra host copy.
uint rawAt(uint i){return (raw[i>>1u]>>((i&1u)*16u))&65535u;}
uniform uvec4 p;

vec2 motionPoint(vec2 p,vec4 m){vec2 v=p-vec2(319.5,255.5);float c=cos(m.z),s=sin(m.z);return vec2(c*v.x-s*v.y,s*v.x+c*v.y)+vec2(319.5,255.5)+m.xy;}

float motionRaw(uint base,vec2 q){uint w=640u,h=512u;q=clamp(q,vec2(0),vec2(w-1u,h-1u));uvec2 j=uvec2(q);vec2 f=fract(q);return mix(mix(float(rawAt(base+j.y*w+j.x)),float(rawAt(base+j.y*w+min(j.x+1u,w-1u))),f.x),mix(float(rawAt(base+min(j.y+1u,h-1u)*w+j.x)),float(rawAt(base+min(j.y+1u,h-1u)*w+min(j.x+1u,w-1u))),f.x),f.y);}

void main(){
uint i=gl_GlobalInvocationID.x;
uint k=i;
 if(k>=p.x||k==0||model[k].w==0)return;uint abase=slots[0]*640*512,bbase=slots[k]*640*512;
 for(uint region=0;region<16;region++){float d[64];bool valid=true;for(uint j=0;j<64;j++){vec2 q=vec2(40+(region%4)*176+(j%8)*2,36+(region/4)*140+(j/8)*2),r=motionPoint(q,model[k]);valid=valid&&all(greaterThanEqual(r,vec2(1)))&&all(lessThan(r,vec2(638,510)));d[j]=float(rawAt(abase+uint(q.y)*640+uint(q.x)))-motionRaw(bbase,r);}for(uint j=0;j<64;j++)deltas[(k*16+region)*65+j]=d[j];deltas[(k*16+region)*65+64]=valid?1:0;}

}
