 index=bestIndex[0];float second=uintBitsToFloat(0x7f800000u);for(uint j=lane;j<nc;j+=64u)if(abs(int(j%side)-int(index%side))>1||abs(int(j/side%side)-int(index/side%side))>1)second=min(second,costs[k*nc+j].x);
