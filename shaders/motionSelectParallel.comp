 best=bestValue[0];second=nextValue[0];vec4 m=p.w==0u?vec4(0):model[k];m.xy+=vec2(int(index%side)-int(p.y),int(index/side%side)-int(p.y))*v.z;m.z+=float(int(index/(side*side))-int(p.z))*v.w;
 float en=costs[k*nc+index].y,scale=640.0/v.x,noise=sigma*sigma/(scale*scale);bool finiteBest=!isnan(best)&&!isinf(best);bool good=p.w==3u?finiteBest:finiteBest&&en>max(.01,noise*.25)&&best<1.25*en+4.0*noise;
 if(p.w==0u)m.w=good&&!isnan(second)&&!isinf(second)&&(second-best)/max(second,1e-6)>.025?1.0:0.0;else m.w*=good?1.0:0.0;model[k]=m;
