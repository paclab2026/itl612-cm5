 uint side=2u*p.y+1u,nc=side*side*(2u*p.z+1u);float best=uintBitsToFloat(0x7f800000u);uint index=0u;
 for(uint j=lane;j<nc;j+=64u){float tie=1e-8*float(abs(int(j%side)-int(p.y))+abs(int(j/side%side)-int(p.y))+abs(int(j/(side*side))-int(p.z))),value=costs[k*nc+j].x+tie;if(value<best){best=value;index=j;}}
