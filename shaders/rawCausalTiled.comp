#version 310 es
precision highp float;
precision highp int;
layout(local_size_x=64) in;
layout(std430,binding=0) readonly buffer B0 {uint raw[];};
layout(std430,binding=1) writeonly buffer B1 {float counts[];};
layout(std430,binding=2) writeonly buffer B2 {float effective[];};
layout(std430,binding=4) readonly buffer B4 {vec2 align[];};
layout(std430,binding=6) readonly buffer B6 {uint slots[];};

// Two exact RAW16 counts per SSBO word; no float widening or extra host copy.
uint rawAt(uint i){return (raw[i>>1u]>>((i&1u)*16u))&65535u;}
uniform uvec4 p;uniform float sigma;
shared float native[100];shared float delta[100];
void main(){uint tid=gl_LocalInvocationID.x,group=gl_WorkGroupID.x;ivec2 origin=ivec2(int(group%80u)*8,int(group/80u)*8);ivec2 q=origin+ivec2(int(tid%8u),int(tid/8u));uint i=uint(q.y*640+q.x),center=(tid/8u+1u)*10u+tid%8u+1u;
 for(uint j=tid;j<100u;j+=64u){ivec2 at=clamp(origin+ivec2(int(j%10u)-1,int(j/10u)-1),ivec2(0),ivec2(639,511));native[j]=float(rawAt(slots[0]*327680u+uint(at.y*640+at.x)));}barrier();float sum=0.0,sw=1.0,sw2=1.0;
 bool interior=q.x>0&&q.y>0&&q.x<639&&q.y<511;
 for(uint k=1u;k<p.y;k++){
 for(uint j=tid;j<100u;j+=64u){ivec2 at=clamp(origin+ivec2(int(j%10u)-1,int(j/10u)-1),ivec2(0),ivec2(639,511));delta[j]=float(rawAt(slots[k]*327680u+uint(at.y*640+at.x)))-native[j]+align[k].x;}barrier();
 if(interior){float mse=0.0;for(int y=-1;y<=1;y++)for(int x=-1;x<=1;x++){float d=delta[uint(int(center)+y*10+x)];mse+=d*d;}float robust=max(0.0,1.0-mse/(9.0*36.0*sigma*sigma)),w=robust*robust*align[k].y;sum+=w*delta[center];sw+=w;sw2+=w*w;}barrier();}
 counts[i]=native[center]+sum/sw;effective[i]=sw*sw/sw2;
}
